---
import Layout from "@layouts/Layout.astro";
import { Button } from "@ui-library";
import { Image } from "astro:assets";
import heroImage from "../images/heroLanding.png";
import teamImage from "../images/gabrielClimateEdgeTeam.png";
import testimonialCaitlin from "../images/testimonialCaitlin.png";
import testimonialLeo from "../images/testimonialLeo.png";
import TextImageBlock from "@components/content-blocks/TextImageBlock/TextImageBlock.astro";
---

<Layout title="Gabriel Brueckner — Strategic Product Designer">
  <main>
    <section class="bg-[#F4F1ED] min-h-[90vh] flex items-center">
      <div class="mx-auto w-full max-w-7xl px-6 lg:px-16 py-20">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">

          <!-- Text -->
          <div class="md:col-span-6 flex flex-col gap-6">
            <p class="text-sm text-gray-500 uppercase tracking-widest">Strategic Product Designer</p>
            <h1 class="heading1">I design products that work for your users and your business.</h1>
            <p class="heading4 text-gray-500">Work with me to augment your product team or as your complete end-to-end product designer.</p>
            <div class="flex gap-x-3 gap-y-4 flex-wrap pt-2">
              <Button href="/projects" text="View projects" variant="secondary" />
              <Button href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ0_sdJRdyctnHs2Vys8RAf8k8rWNtaHXRaxvUNOqwKOPd_WX1Lx-SP-97Q3RU55vz3R30CkdA4v" text="Schedule a call" variant="primary" umamiEvent="contact-click" target="_blank" />
            </div>
          </div>

          <!-- Image -->
          <div class="md:col-span-6 md:col-start-7">
            <Image
              src={heroImage}
              alt="Strategic Product Design"
              class="rounded-xl w-full object-cover"
            />
          </div>

        </div>
      </div>
    </section>

    <section class="bg-white py-16 md:py-24 mb-16 md:mb-24">
      <TextImageBlock
        subHeading="Strategic product design in practice"
        heading="Turning messy problems into shippable products"
        image={teamImage}
        imageAlt="Gabriel Brueckner with the Climate Edge team"
        imagePosition="right"
        imageSize="medium"
      >
        <p class="body">I get involved early to help senior leaders and product teams understand the problem space before we explore solutions. I use a discovery‑led, user‑centred process, talking to customers, prototyping, and testing to clarify where product can unlock real business value. <br /><br /> From there, I design the systems and workflows, collaborate closely with leadership and engineering, and prioritise work using first‑principles thinking so we ship the right things in the right order.</p>
      </TextImageBlock>
    </section>

    <section class="py-16 md:py-24 mb-16 md:mb-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-16">
        <h2 class="heading3 text-gray-400 mb-8 md:mb-16">Testimonials</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

          <figure class="bg-[#F4F1ED] rounded-2xl p-8 md:p-10 flex flex-col justify-between gap-8">
            <blockquote class="body text-gray-800 italic">
              <p>Gabriel is an exceptional product talent and someone I was lucky enough to work alongside for nearly three years. His deep end-to-end expertise across Product Strategy and Design gives him the rare ability to take an idea from strategy, user research, and concept development through to launch.</p>
              <p class="mt-4">He particularly shines when breaking new ground and balancing innovative MVPs with long-term vision and business results. His creative and practical approach transformed how we delivered product at Provenance and makes him one of my favourite people to ideate with.</p>
            </blockquote>
            <figcaption class="flex items-center gap-4">
              <Image src={testimonialCaitlin} alt="Caitlin Jones" class="size-24 rounded-full object-cover flex-shrink-0" />
              <div>
                <a href="https://www.linkedin.com/in/caitlin-jones-80b1b83b/" target="_blank" rel="noopener noreferrer" class="font-semibold text-gray-900 hover:underline">Caitlin Jones</a>
                <p class="text-sm text-gray-500">Head of Product, Provenance</p>
              </div>
            </figcaption>
          </figure>

          <figure class="bg-[#F4F1ED] rounded-2xl p-8 md:p-10 flex flex-col justify-between gap-8">
            <blockquote class="body text-gray-800 italic">
              <p>Gabriel joined our team at the perfect moment as a product discovery expert. He executed thorough user research, ideation, and concept development, seamlessly taking features from initial ideas all the way through to UI design. Gabriel also collaborated effectively with our frontend engineers during implementation.</p>
              <p class="mt-4">Additionally, he provided invaluable support in product management responsibilities. He structured product initiatives for our 'Podium' web app and assisted with requirements gathering and documentation. I highly recommend Gabriel for any digital product needs, especially in smaller teams.</p>
            </blockquote>
            <figcaption class="flex items-center gap-4">
              <Image src={testimonialLeo} alt="Leonidas Spiliopoulos" class="size-24 rounded-full object-cover flex-shrink-0" />
              <div>
                <a href="https://www.linkedin.com/in/leonidas-spiliopoulos-99a00221/" target="_blank" rel="noopener noreferrer" class="font-semibold text-gray-900 hover:underline">Leonidas Spiliopoulos</a>
                <p class="text-sm text-gray-500">Head of Product, Wattstor</p>
              </div>
            </figcaption>
          </figure>

        </div>
      </div>
    </section>
  </main>
</Layout>
