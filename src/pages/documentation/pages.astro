---
import Documentation from "@layouts/Documentation.astro";
import { Typography } from "@ui-library";
---

<Documentation title="Pages - Documentation">
  <Fragment slot="main-content">
    <Typography variant="heading2" as="h1">Pages</Typography>
    <Typography variant="bodySmall">
      This theme comes with a collection of pre-built pages to help you hit the
      ground running.
    </Typography>
    <Typography variant="bodySmall">
      Each page is thoughtfully designed with clean, accessible code and modern
      layouts, making it easy to customize and adapt to your needs. Whether
      you're building a portfolio, blog, or business site, these pages provide a
      solid starting point. Below is a list of the included pages:
    </Typography>
    <ul>
      <li><a href="/">Landing Page One</a></li>
      <li><a href="/about">About Page</a></li>
      <li><a href="/blog">Blog Landing Page</a></li>
      <li><a href="/blog/article">Blog Article Page</a></li>
      <li><a href="/projects">Portfolio Landing Page</a></li>
      <li><a href="/projects/project-1">Portfolio Page</a></li>
      <li><a href="/coming-soon">Coming Soon Page</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/404">404 Page</a></li>
    </ul>
  </Fragment>
</Documentation>
