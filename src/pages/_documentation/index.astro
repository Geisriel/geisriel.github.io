---
import Documentation from "../../layouts/Documentation.astro";
import { Typography } from "@ui-library";
---

<Documentation title="Documentation">
  <Fragment slot="main-content">
    <Typography variant="heading2" as="h1">Documentation</Typography>
    <Typography variant="body-small">
      Thank you for choosing this Astro theme! This documentation is your go-to
      resource for understanding, customizing, and maximizing the potential of
      your new theme.
    </Typography>

    <Typography variant="body-small">
      Whether you're setting up your first Astro site or tweaking the design to
      suit your unique needs, you'll find everything you need here. The theme is
      designed to be developer-friendly, lightweight, and highly customizable,
      so you can build the perfect website with ease.
    </Typography>
  </Fragment>
</Documentation>
