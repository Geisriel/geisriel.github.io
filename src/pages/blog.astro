---
import Layout from "@layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { Typography } from "@ui-library";
type Post = CollectionEntry<"post">;
const posts: Post[] = (await getCollection("post")).sort(
  (a: Post, b: Post) =>
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  });
}
---

<Layout title="Blog">
  <main class="flex flex-col gap-24 lg:gap-32">
    <div
      class="mx-auto w-full items-center max-w-3xl text-center mt-20 px-6 flex flex-col gap-6"
    >
      <Typography variant="heading1" as="h1">Behind the Designs</Typography>
      <Typography variant="body" as="p">
        Design insights, personal stories, and lessons learned along the way.
      </Typography>
    </div>
    <section
      class="mx-auto max-w-7xl px-6 lg:px-16 flex flex-col md:flex-row flex-nowrap justify-between gap-12"
    >
      <div class="grid md:grid-cols-12">
        {
          posts.map(({ data }) => {
            return (
              <div class="md:col-start-2 md:col-span-10">
                <a
                  href={`/blog/${data.slug}`}
                  class="flex w-full gap-8 items-start group relative"
                >
                  <div class="flex-grow flex flex-wrap justify-between items-center gap-6 border-b-2 border-gray-900 px-6 py-8 relative before:absolute before:inset-0 before:bg-gray-50 before:origin-left before:scale-x-0 before:transition-transform before:duration-300 before:ease-out group-hover:before:scale-x-100 before:-z-10">
                    <Typography variant="heading4" as="h2">
                      {data.title}
                    </Typography>
                    <Typography
                      variant="body"
                      as="p"
                      class="text-gray-500 uppercase"
                    >
                      {formatDate(data.publishDate)}
                    </Typography>
                    <Typography variant="body" as="p">
                      {data.description}
                    </Typography>
                  </div>
                </a>
              </div>
            );
          })
        }

        <div
          class="md:col-start-4 md:col-span-6 justify-self-center w-full mt-24"
        >
          <nav
            class="isolate inline-flex -space-x-px justify-between w-full"
            aria-label="Pagination"
          >
            <a
              href="#"
              class="relative inline-flex items-center px-2 py-2 text-gray-400 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 focus-visible:outline-gray-900 focus-visible:text-gray-900"
            >
              <span class="sr-only">Previous</span>
              <svg
                class="size-5"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
                data-slot="icon"
              >
                <path
                  fill-rule="evenodd"
                  d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
            <div>
              <a
                href="#"
                aria-current="page"
                class="relative z-10 inline-flex items-center bg-gray-900 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
                >1</a
              >
              <a
                href="#"
                class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 focus:z-20 focus:outline-offset-0 focus-visible:outline-gray-900"
                >2</a
              >
              <a
                href="#"
                class="relative hidden items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 focus:z-20 focus:outline-offset-0 md:inline-flex focus-visible:outline-gray-900"
                >3</a
              >
              <span
                class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-gray-300 ring-inset focus:outline-offset-0"
                >...</span
              >
              <a
                href="#"
                class="relative hidden items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 focus:z-20 focus:outline-offset-0 md:inline-flex focus-visible:outline-gray-900"
                >8</a
              >
              <a
                href="#"
                class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 focus:z-20 focus:outline-offset-0 focus-visible:outline-gray-900"
                >9</a
              >
              <a
                href="#"
                class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-gray-300 ring-inset hover:bg-gray-50 focus:z-20 focus:outline-offset-0 focus-visible:outline-gray-900"
                >10</a
              >
            </div>
            <a
              href="#"
              class="relative inline-flex items-center px-2 py-2 text-gray-400 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 focus-visible:outline-gray-900 focus-visible:text-gray-900"
            >
              <span class="sr-only">Next</span>
              <svg
                class="size-5"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
                data-slot="icon"
              >
                <path
                  fill-rule="evenodd"
                  d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
          </nav>
        </div>
      </div>
    </section>
  </main>
</Layout>
