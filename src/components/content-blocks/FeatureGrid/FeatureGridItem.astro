---
import { Typography } from "@ui-library";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  prefix?: string;
  title: string;
  description: string;
  size?: "default" | "compact";
  href?: string;
  image?: ImageMetadata;
}

const { prefix, title, description, size = "default", href, image } = Astro.props;
---

{size === "compact" ? (
  <div class={image ? "flex gap-4 items-start" : undefined}>
    {image && <Image class="rounded-lg w-16 h-16 object-cover flex-shrink-0" src={image} alt={title} />}
    <div>
      {prefix && <p class="text-sm text-gray-400 mb-2">{prefix}</p>}
      <h3 class="heading6 mb-2">
        {href ? <a href={href} target="_blank" rel="noopener noreferrer" class="title-link">{title}</a> : title}
      </h3>
      <p class="text-sm text-gray-500">{description}</p>
    </div>
  </div>
) : (
  <div>
    {prefix && (
      <Typography variant="heading2" as="div" class="mb-2">
        {prefix}
      </Typography>
    )}
    <Typography variant="heading5" as="h3" class="mb-2">
      {href ? <a href={href} target="_blank" rel="noopener noreferrer" class="title-link">{title}</a> : title}
    </Typography>
    <Typography>{description}</Typography>
  </div>
)}

<style>
  .title-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .title-link:hover {
    border-bottom-color: currentColor;
  }
</style>
