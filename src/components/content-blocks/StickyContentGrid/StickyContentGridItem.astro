---
import { Typography } from "@ui-library";

interface Props {
  itemNumber: string;
  heading: string;
  text: string;
}

const { itemNumber, heading, text } = Astro.props;
---

<div class={`md:mb-8 md:w-[45%] relative sticky-grid-item`}>
  <Typography variant="bodySmall" as="p" class="mb-2 text-gray-500">
    {itemNumber}
  </Typography>
  <Typography variant="heading5" as="h5" class="mb-6">
    {heading}
  </Typography>
  <Typography variant="body" as="p" class="mb-4">
    {text}
  </Typography>
</div>

<style>
  @media (min-width: 768px) {
    .sticky-grid-item:nth-child(even) {
      top: 128px;
    }
  }
</style>
