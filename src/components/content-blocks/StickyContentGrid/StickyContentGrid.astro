---
import { Typography } from "@ui-library";

interface Props {
  className?: string;
  heading: string;
  subHeading?: string;
  text: string;
}

const { heading, subHeading, text, className } = Astro.props;
---

<div class:list={["mx-auto max-w-7xl px-6 lg:px-8 flex flex-col md:flex-row flex-nowrap justify-between gap-12", className]}>
  {/* Sticky Left Column */}
  <div class="md:w-1/2">
    <div class="md:max-w-lg sticky top-4">
      {
        subHeading && (
          <Typography
            variant="body-small"
            as="p"
            class="text-gray-500 mb-4 uppercase"
          >
            {subHeading}
          </Typography>
        )
      }
      <Typography variant="heading2" as="h2" class="mb-6">
        {heading}
      </Typography>
      <Typography variant="body" as="p">
        {text}
      </Typography>
    </div>
  </div>

  {/* Flowing Right Grid */}
  <div
    class="sticky-content-grid-items md:w-1/2 flex items-center content-center gap-8 flex-wrap justify-between"
  >
    <slot name="grid-items" />
  </div>
</div>
