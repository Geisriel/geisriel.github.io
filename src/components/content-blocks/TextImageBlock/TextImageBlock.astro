---
import { Typography } from "@ui-library";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  className?: string;
  heading: string;
  subHeading: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: "left" | "right";
  imageSize?: "default" | "large";
}

const {
  className,
  heading,
  subHeading,
  image,
  imageAlt,
  imagePosition = "right",
  imageSize = "default",
} = Astro.props;

const isLarge = imageSize === "large";
---

<div class:list={["mx-auto max-w-7xl px-6 lg:px-8", className]}>
  <div class="grid gap-6 grid-cols-1 md:grid-cols-12 items-center">
    {
      imagePosition === "left" ? (
        <div class={isLarge ? "md:col-start-1 md:col-span-8" : "md:col-start-2 md:col-span-4"}>
          <Image class="rounded-xl w-full" src={image} alt={imageAlt} />
        </div>
      ) : null
    }

    <div
      class={
        isLarge
          ? `md:col-span-3 ${imagePosition === "right" ? "md:col-start-2" : "md:col-start-10"}`
          : `md:col-span-5 ${imagePosition === "right" ? "md:col-start-2" : "md:col-start-7"}`
      }
    >
      <Typography
        variant="body-small"
        as="p"
        class="text-gray-500 mb-4 uppercase"
      >
        {subHeading}
      </Typography>
      <Typography variant="heading2" as="h2" class="mb-8">
        {heading}
      </Typography>
      <slot/>
    </div>

    {
      imagePosition === "right" ? (
        <div class={isLarge ? "md:col-start-6 md:col-span-7" : "md:col-start-8 md:col-span-4"}>
          <Image class="rounded-xl w-full" src={image} alt={imageAlt} />
        </div>
      ) : null
    }
  </div>
</div>
