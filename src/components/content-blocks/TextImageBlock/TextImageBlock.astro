---
import { Typography } from "@ui-library";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  className?: string;
  heading: string;
  subHeading: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: "left" | "right";
}

const {
  className,
  heading,
  subHeading,
  image,
  imageAlt,
  imagePosition = "right",
} = Astro.props;
---

<div class:list={["mx-auto max-w-7xl px-6 lg:px-8", className]}>
  <div class="grid gap-6 grid-cols-1 md:grid-cols-12 items-center">
    {
      imagePosition === "left" ? (
        <div class="md:col-start-2 md:col-span-4">
          <Image class="rounded-3xl w-full" src={image} alt={imageAlt} />
        </div>
      ) : null
    }

    <div
      class={`md:col-span-5 ${imagePosition === "right" ? "md:col-start-2" : "md:col-start-7"}`}
    >
      <Typography
        variant="bodySmall"
        as="p"
        class="text-gray-500 mb-4 uppercase"
      >
        {subHeading}
      </Typography>
      <Typography variant="heading2" as="h2" class="mb-8">
        {heading}
      </Typography>
      <slot/>
    </div>

    {
      imagePosition === "right" ? (
        <div class="md:col-start-8 md:col-span-4">
          <Image class="rounded-3xl w-full" src={image} alt={imageAlt} />
        </div>
      ) : null
    }
  </div>
</div>
