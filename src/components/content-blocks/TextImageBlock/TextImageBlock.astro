---
import { Typography } from "@ui-library";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  className?: string;
  heading: string;
  subHeading: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: "left" | "right";
  imageSize?: "default" | "medium" | "large";
  imageCaption?: string;
}

const {
  className,
  heading,
  subHeading,
  image,
  imageAlt,
  imagePosition = "right",
  imageSize = "default",
  imageCaption,
} = Astro.props;

const imageLeftClass = imageSize === "large"
  ? "md:col-start-1 md:col-span-8"
  : imageSize === "medium"
  ? "md:col-start-1 md:col-span-5"
  : "md:col-start-2 md:col-span-4";

const imageRightClass = imageSize === "large"
  ? "md:col-start-5 md:col-span-8"
  : imageSize === "medium"
  ? "md:col-start-8 md:col-span-5"
  : "md:col-start-8 md:col-span-4";

const textClass = imageSize === "large"
  ? `md:col-span-4 ${imagePosition === "right" ? "md:col-start-1" : "md:col-start-9"}`
  : imageSize === "medium"
  ? `md:col-span-6 ${imagePosition === "right" ? "md:col-start-1" : "md:col-start-7"}`
  : `md:col-span-5 ${imagePosition === "right" ? "md:col-start-2" : "md:col-start-7"}`;
---

<div class:list={["mx-auto max-w-7xl px-6 lg:px-16", className]}>
  <div class="grid gap-6 grid-cols-1 md:grid-cols-12 items-center">
    {
      imagePosition === "left" ? (
        <div class={imageLeftClass}>
          <Image class="rounded-xl w-full" src={image} alt={imageAlt} />
          {imageCaption && <p class="text-sm text-gray-400 mt-3">{imageCaption}</p>}
        </div>
      ) : null
    }

    <div class={textClass}>
      <Typography
        variant="body-small"
        as="p"
        class="text-gray-500 mb-4 uppercase"
      >
        {subHeading}
      </Typography>
      <Typography variant="heading2" as="h2" class="mb-8">
        {heading}
      </Typography>
      <slot/>
    </div>

    {
      imagePosition === "right" ? (
        <div class={imageRightClass}>
          <Image class="rounded-xl w-full" src={image} alt={imageAlt} />
          {imageCaption && <p class="text-sm text-gray-400 mt-3">{imageCaption}</p>}
        </div>
      ) : null
    }
  </div>
</div>
