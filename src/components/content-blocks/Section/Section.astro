---
interface Props {
  background?: "default" | "subtle" | "dark";
  heading?: string;
  className?: string;
}

const { background = "default", heading, className } = Astro.props;

const backgroundClass = {
  default: "bg-white",
  subtle: "bg-[#F4F1ED]",
  dark: "bg-gray-900",
}[background];
---

<section class:list={["not-prose py-16 md:py-24 mb-16 md:mb-24", backgroundClass, className]}>
  {heading && (
    <div class="mx-auto max-w-7xl px-6 lg:px-16 mb-8 md:mb-16">
      <h2 class="heading3 text-gray-400">{heading}</h2>
    </div>
  )}
  <div class="flex flex-col gap-12 md:gap-24">
    <slot />
  </div>
</section>
