---
import { Typography } from "@ui-library";

interface Props {
  className?: string;
  heading: string;
  subHeading?: string;
}

const { heading, subHeading, className } = Astro.props;
---

<div class:list={["mx-auto max-w-3xl px-6 lg:px-8 md:text-center", className]}>
  <Typography variant="bodySmall" as="p" class="text-gray-500 mb-4 uppercase">
    {subHeading}
  </Typography>
  <Typography variant="heading2" as="h2" class="mb-8">
    {heading}
  </Typography>
  <slot/>
</div>
