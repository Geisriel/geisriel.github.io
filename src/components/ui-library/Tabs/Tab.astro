---
type Props = {
  id: string;
};
const { id } = Astro.props;
---

<button
  role="tab"
  data-tab={id}
  id={`${id}-control`}
  aria-controls={`${id}-panel`}
  aria-selected={false}
>
  <slot />
</button>

<style>
  [role="tab"] {
    padding: 0.5rem 1rem;
    border: none;
    background: none;
    color: #666;
    cursor: pointer;
    text-decoration: none;
    margin-bottom: -0.5rem;
  }

  [role="tab"]:hover {
    color: #000;
  }

  [role="tab"].active {
    color: #000;
    border-bottom: 2px solid #000;
  }
</style>
