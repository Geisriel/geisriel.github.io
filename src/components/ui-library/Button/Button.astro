---
type Props = {
  href: string;
  text: string;
  className?: string;
  variant?: "primary" | "secondary";
};

const { href, text, className = "", variant = "secondary" } = Astro.props;
---

<a
  class={`button ${
    variant === "primary" ? "button-primary" : "button-secondary"
  } ${className}`}
  href={href}
>
  <span class="circle" aria-hidden="true">
    <span class="icon arrow"></span>
  </span>
  <span class="button-text">{text}</span>
</a>

<style>
  /***************************************
   * Base button styling
   ***************************************/
  .button {
    position: relative;
    display: inline-block;
    cursor: pointer;
    outline: none;
    border: 0;
    vertical-align: middle;
    text-decoration: none;
    font-size: inherit;
    font-family: inherit;
    height: auto;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  /***************************************
   * Primary button
   ***************************************/
  .button-primary {
    color: white;
    background-color: #111827; /*gray-900*/
    padding: 0.75rem 1.5rem;
    text-align: center;
    font-weight: bold;
    text-transform: uppercase;
    border-radius: 999px;
    overflow: hidden;
    z-index: 0;
  }
  .button-primary::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background-color: #6B7280; /*gray-500*/
    z-index: -1;
    transition: transform 0.3s ease;
    transform: translateX(0);
  }
  .button-primary:hover::before {
    transform: translateX(100%);
  }
  .button-primary .button-text {
    position: relative;
    z-index: 1;
  }

  /***************************************
   * Secondary button
   ***************************************/
  .button-secondary {
    padding-left: 3.5rem;
    border-radius: 999px;
  }

  /* The "circle" that expands on hover */
  .button-secondary .circle {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    background: #111827; /*gray-900*/
    border-radius: 1.625rem;
    transition: width 0.45s cubic-bezier(0.65, 0, 0.076, 1);
    z-index: 0;
    overflow: hidden;
  }

  /* The arrow inside the circle */
  .button-secondary .icon.arrow {
    position: absolute;
    top: 50%;
    left: 1.5rem;
    transform: translate(-50%, -50%);
    width: 1.125rem;
    height: 0.125rem;
    background: #fff;
    transition: none;
  }
  /* The arrow's diagonal tip */
  .button-secondary .icon.arrow::before {
    content: "";
    position: absolute;
    top: -0.3rem;
    right: 0;
    width: 0.625rem;
    height: 0.625rem;
    border-top: 0.125rem solid #fff;
    border-right: 0.125rem solid #fff;
    transform: rotate(45deg);
  }

  /* The text sits to the right of the circle */
  .button-secondary .button-text {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin: 0;
    padding: 0.75rem 1rem 0.75rem 0.25rem;
    color: #111827; /*gray-900*/
    font-weight: 700;
    line-height: 1.6;
    text-align: center;
    text-transform: uppercase;
    transition: color 0.45s cubic-bezier(0.65, 0, 0.076, 1);
  }

  /* Hover: circle expands under the text */
  .button-secondary:hover .circle {
    width: 100%;
  }
  .button-secondary:hover .button-text {
    color: white;
  }

  /***************************************
   * Focus (Keyboard) states
   ***************************************/
  .button:focus-visible, .button:focus-within {
    outline: 2px solid #111827; /*gray-900*/
    outline-offset: 2px;
  }
</style>