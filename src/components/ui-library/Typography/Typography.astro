---
type Props = {
  /**
   * Specify a semantic HTML element to use.
   */
  as?:
    | "p"
    | "h1"
    | "h2"
    | "h3"
    | "h4"
    | "h5"
    | "h6"
    | "span"
    | "div"
    | "caption";
  /**
   * Applies the correct typography styles
   */
  variant?:
    | "heading1"
    | "heading2"
    | "heading3"
    | "heading4"
    | "heading5"
    | "heading6"
    | "body"
    | "body-small"
    | "caption";
  class?: string;
};

const {
  as = "p",
  variant = "body",
  class: classAttr = "",
}: Props = Astro.props;
const Element = as;

const variantClass = variant === "body-small"
  ? "text-sm leading-5 text-gray-500"
  : variant;
---

<Element class:list={[classAttr, variantClass]}>
  <slot />
</Element>

