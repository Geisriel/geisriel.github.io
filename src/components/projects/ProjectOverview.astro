---
import { Typography } from "@ui-library";
import { Image } from "astro:assets";
import type { InferEntrySchema } from "astro:content";

type Project = InferEntrySchema<"project">;

type Props = Pick<
  Project,
  "title" | "slug" | "subtitle" | "featureImageSmall" | "featureImageLarge"
> & {
  orientation?: "captionLeft" | "captionRight";
};

const {
  title,
  slug,
  subtitle,
  featureImageSmall,
  featureImageLarge,
  orientation = "captionLeft",
} = Astro.props;
---

<div class="relative">
  <a
    href={`/projects/${slug}`}
    class:list={[
      "flex flex-col md:flex-row gap-8 js-project-container js-hover-trigger relative",
      { "md:flex-row-reverse": orientation === "captionRight" },
    ]}
  >
    <div class="md:w-1/3">
      <div class="lg:sticky pt-6 top-0 md:-mt-6">
        <div class="pb-6">
          <Typography variant="heading4" as="h4" class="mb-6">
            {title}
          </Typography>
          <Typography variant="body" as="p">
            {subtitle}
          </Typography>
        </div>
        {
          featureImageSmall && (
            <div class="relative">
              <Image
                src={featureImageSmall}
                alt={`${title} feature image 1`}
                loading="lazy"
                class="w-full rounded-xl bg-slate-100"
              />
            </div>
          )
        }
      </div>
    </div>

    <div class="md:flex-grow md:min-w-[65%] md:max-w-[65%]">
      {
        featureImageLarge && (
          <div class="relative">
            <Image
              src={featureImageLarge}
              alt={`${title} feature image 2`}
              loading="lazy"
              class="w-full rounded-xl bg-slate-100"
            />
          </div>
        )
      }
    </div>
  </a>

  <div
    class="js-floating-view-button z-50 rounded-sm pointer-events-none opacity-0 fixed bg-white/40 backdrop-blur-sm
 p-1 transform -translate-x-1/2 -translate-y-1/2 transition-opacity duration-200 shadow-lg"
  >
    <div class="bg-white px-6 py-2 text-black text-xs rounded-sm">
      View Project
    </div>
  </div>
</div>

<script>
  const projectContainers = document.querySelectorAll(".js-project-container");

  projectContainers.forEach((container) => {
    const floatingButton = container.parentElement?.querySelector(
      ".js-floating-view-button"
    );

    if (!floatingButton) return;

    container.addEventListener("mouseenter", () => {
      if (floatingButton instanceof HTMLElement) {
        floatingButton.style.opacity = "1";
      }
    });

    container.addEventListener("mouseleave", () => {
      if (floatingButton instanceof HTMLElement) {
        floatingButton.style.opacity = "0";
      }
    });

    container.addEventListener("mousemove", ((e: MouseEvent) => {
      if (floatingButton instanceof HTMLElement) {
        const x = e.clientX;
        const y = e.clientY - 30;

        floatingButton.style.left = `${x}px`;
        floatingButton.style.top = `${y}px`;
      }
    }) as EventListener);
  });
</script>
