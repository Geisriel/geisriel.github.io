---

<ul class={`flex gap-4 ${className}`}>
  {
    socialLinks.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.ariaLabel}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="24px"
            height="24px"
            class="fill-white hover:fill-gray-400"
          >
            <title>{link.title}</title>
            <path d={link.path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
