---
import { Typography, Button } from "@ui-library";
import SocialLinks from "@components/SocialLinks.astro";
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#F4F1ED] mt-24 px-4">
  <div
    class="mx-auto w-full max-w-7xl py-12 grid md:grid-cols-2 gap-8 items-center"
  >
    <ul class="flex flex-col gap-4 text-3xl font-light">
      <li><a href="/projects">Projects</a></li>
      <li><a href="/about">About</a></li>
    </ul>
    <div class="md:text-right flex flex-col gap-4 items-start md:items-end">
      <Typography as="p" variant="body">London, UK</Typography>
      <Typography variant="heading3" as="p">
        <a href="mailto:mail@gabriel-brueckner.com">mail@gabriel-brueckner.com</a>
      </Typography>
      <div class="flex gap-3 flex-wrap justify-start md:justify-end">
        <Button href="mailto:mail@gabriel-brueckner.com" text="Send an email" variant="primary" />
        <Button href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ0_sdJRdyctnHs2Vys8RAf8k8rWNtaHXRaxvUNOqwKOPd_WX1Lx-SP-97Q3RU55vz3R30CkdA4v" text="Schedule a call" variant="secondary" target="_blank" />
      </div>
    </div>
  </div>
  <div
    class="mx-auto w-full max-w-7xl py-6 grid grid-cols-2 md:grid-cols-3 gap-8 items-center"
  >
    <Logo />
    <div
      class="md:justify-self-center order-1 md:order-2 col-span-2 md:col-span-1"
    >
      <SocialLinks />
    </div>
    <div class="order-3">
      <Typography variant="body-small" as="p" class="md:text-right">
        © {currentYear} | <a href="/privacy">Privacy</a>
      </Typography>
    </div>
  </div>
</footer>
